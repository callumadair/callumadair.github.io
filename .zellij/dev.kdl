layout {
    pane split_direction="horizontal" {
        pane split_direction="vertical" {
            pane {
                name "Shell"
                borderless false
            }
            pane {
                command "docker"
                args "compose" "up" "db"
                name "Postgres Database (Container)"
                borderless false
            }
            pane {
                command "bacon"
                args "clippy"
                cwd "./backend"
                name "Clippy Workspace"
                borderless false
            }
        }
        pane split_direction="vertical" {
            pane {
                command "bacon"
                args "run"
                cwd "./backend"
                name "Portfolio Backend (Local)"
                borderless false
            }
            pane {
                command "bun"
                args "run" "dev" "-o"
                cwd "./nuxt-frontend"
                name "Portfolio Frontend (Local)"
                borderless false
            }
        }
    }
}
